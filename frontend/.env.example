# Địa chỉ backend NestJS (mặc định http://localhost:3000)
VITE_API_URL=http://localhost:3000

# Danh tính TẠM cho giai đoạn chưa có đăng nhập thật (S1-01). Backend hiện đọc hai header
# x-user-id / x-user-roles. Khi có đăng nhập, bỏ hai biến này và sửa getAuthHeaders() trong
# src/features/account-lock/api.ts.
VITE_DEV_USER_ID=admin-1
VITE_DEV_USER_ROLES=ADMIN
